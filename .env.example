# Copy to .env for local preview/build (git-ignored).
# Use the publishable (anon) key only — never put service_role here.

SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_PUBLISHABLE_KEY=your-publishable-anon-key

# Optional aliases (build.js accepts these too)
# SUPABASE_ANON_KEY=your-publishable-anon-key

# Server-only: local Vercel API preview. Never expose with a public prefix.
GEMINI_API_KEY=your-paid-gemini-api-key
GEMINI_MODEL=gemini-2.5-flash
